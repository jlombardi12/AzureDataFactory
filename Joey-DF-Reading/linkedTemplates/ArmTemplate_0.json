{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "Joey-DF-Reading"
		},
		"AzureBlobStorageReading_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorageReading'"
		},
		"AzurePostgreSqlReading_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzurePostgreSqlReading'"
		},
		"BronzeReading_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'BronzeReading'"
		},
		"AzurePostgreSqlReading_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "joeydbpostgre.postgres.database.azure.com"
		},
		"AzurePostgreSqlReading_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Reading"
		},
		"AzurePostgreSqlReading_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "jlombardi"
		},
		"BronzeReading_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "reading.database.windows.net"
		},
		"BronzeReading_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "BronzeReading"
		},
		"BronzeReading_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "jlombardi"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/AzureBlobStorageReading')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"connectionString": "[parameters('AzureBlobStorageReading_connectionString')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzurePostgreSqlReading')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzurePostgreSql",
				"version": "2.0",
				"typeProperties": {
					"server": "[parameters('AzurePostgreSqlReading_properties_typeProperties_server')]",
					"port": "5432",
					"database": "[parameters('AzurePostgreSqlReading_properties_typeProperties_database')]",
					"sslMode": 2,
					"username": "[parameters('AzurePostgreSqlReading_properties_typeProperties_username')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('AzurePostgreSqlReading_password')]"
					},
					"authenticationType": "Basic"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/BronzeReading')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('BronzeReading_properties_typeProperties_server')]",
					"database": "[parameters('BronzeReading_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": true,
					"authenticationType": "SQL",
					"userName": "[parameters('BronzeReading_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('BronzeReading_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/2025Reading')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "BronzeReading",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {
					"schema": "dbo",
					"table": "2025Reading"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/BronzeReading')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DestinationDataset_fqo')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzurePostgreSqlReading",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzurePostgreSqlTable",
				"schema": [
					{
						"name": "bookid",
						"type": "integer",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "title",
						"type": "character varying",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "author",
						"type": "character varying",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "addauthors",
						"type": "character varying",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "isbn10",
						"type": "character",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "isbn13",
						"type": "bigint",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "avgrating",
						"type": "numeric",
						"precision": 10,
						"scale": 2
					},
					{
						"name": "publisher",
						"type": "character varying",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "binding",
						"type": "character varying",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "pagecount",
						"type": "integer",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "publishyear",
						"type": "integer",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "originalpublicationyear",
						"type": "integer",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "datestarted",
						"type": "date",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "datefinished",
						"type": "date",
						"precision": 0,
						"scale": 0
					}
				],
				"typeProperties": {
					"schema": "bronze",
					"table": "2025Reading"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzurePostgreSqlReading')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/SourceDataset_fqo')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureBlobStorageReading",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"container": "reading"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "Book Id",
						"type": "String"
					},
					{
						"name": "Title",
						"type": "String"
					},
					{
						"name": "Author",
						"type": "String"
					},
					{
						"name": "Additional Authors",
						"type": "String"
					},
					{
						"name": "ISBN",
						"type": "String"
					},
					{
						"name": "ISBN13",
						"type": "String"
					},
					{
						"name": "My Rating",
						"type": "String"
					},
					{
						"name": "Average Rating",
						"type": "String"
					},
					{
						"name": "Publisher",
						"type": "String"
					},
					{
						"name": "Binding",
						"type": "String"
					},
					{
						"name": "Number of Pages",
						"type": "String"
					},
					{
						"name": "Year Published",
						"type": "String"
					},
					{
						"name": "Original Publication Year",
						"type": "String"
					},
					{
						"name": "Date Started",
						"type": "String"
					},
					{
						"name": "Date Read",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureBlobStorageReading')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/CopyAzureBlobStorageReading')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Copying data from Reading Azure Blob Storage Container into postgreSQL",
				"activities": [
					{
						"name": "Copy_fqo",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [
							{
								"name": "Source",
								"value": "reading//"
							},
							{
								"name": "Destination",
								"value": "bronze.2025Reading"
							}
						],
						"typeProperties": {
							"source": {
								"type": "DelimitedTextSource",
								"storeSettings": {
									"type": "AzureBlobStorageReadSettings",
									"recursive": true,
									"wildcardFileName": "*",
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							},
							"sink": {
								"type": "AzureSqlSink",
								"writeBehavior": "insert",
								"sqlWriterUseTableLock": false,
								"tableOption": "autoCreate",
								"disableMetricsCollection": false
							},
							"enableStaging": false,
							"validateDataConsistency": false,
							"translator": {
								"type": "TabularTranslator",
								"mappings": [
									{
										"source": {
											"name": "Book Id",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "bookid",
											"type": "Int32",
											"physicalType": "integer"
										}
									},
									{
										"source": {
											"name": "Title",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "title",
											"type": "String",
											"physicalType": "character varying"
										}
									},
									{
										"source": {
											"name": "Author",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "author",
											"type": "String",
											"physicalType": "character varying"
										}
									},
									{
										"source": {
											"name": "Additional Authors",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "addauthors",
											"type": "String",
											"physicalType": "character varying"
										}
									},
									{
										"source": {
											"name": "ISBN",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "isbn10",
											"type": "String",
											"physicalType": "character"
										}
									},
									{
										"source": {
											"name": "ISBN13",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "isbn13",
											"type": "Int64",
											"physicalType": "bigint"
										}
									},
									{
										"source": {
											"name": "Average Rating",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "avgrating",
											"type": "Decimal",
											"physicalType": "numeric"
										}
									},
									{
										"source": {
											"name": "Publisher",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "publisher",
											"type": "String",
											"physicalType": "character varying"
										}
									},
									{
										"source": {
											"name": "Binding",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "binding",
											"type": "String",
											"physicalType": "character varying"
										}
									},
									{
										"source": {
											"name": "Number of Pages",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "pagecount",
											"type": "Int32",
											"physicalType": "integer"
										}
									},
									{
										"source": {
											"name": "Year Published",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "publishyear",
											"type": "Int32",
											"physicalType": "integer"
										}
									},
									{
										"source": {
											"name": "Original Publication Year",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "originalpublicationyear",
											"type": "Int32",
											"physicalType": "integer"
										}
									},
									{
										"source": {
											"name": "Date Started",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "datestarted",
											"type": "DateTime",
											"physicalType": "date"
										}
									},
									{
										"source": {
											"name": "Date Read",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "datefinished",
											"type": "DateTime",
											"physicalType": "date"
										}
									}
								],
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "SourceDataset_fqo",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "2025Reading",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2025-11-03T23:09:37Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/SourceDataset_fqo')]",
				"[concat(variables('factoryId'), '/datasets/2025Reading')]"
			]
		}
	]
}